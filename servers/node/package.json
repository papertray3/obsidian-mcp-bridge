{
  "name": "obsidian-mcp-server-node",
  "version": "1.0.0",
  "description": "Node/TypeScript MCP server for Obsidian Direct API Bridge",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "obsidian-mcp": "dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:once": "vitest run",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rimraf dist",
    "package": "npm run build && npm run package:binaries",
    "package:binaries": "echo 'Binary packaging with pkg/nexe - TBD in Workstream 4'"
  },
  "keywords": [
    "obsidian",
    "mcp",
    "ai",
    "claude",
    "gemini",
    "codex"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "ws": "^8.18.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
