# Obsidian MCP Bridge Configuration
# Copy this file to .env and fill in your values

# Obsidian plugin connection settings
OBSIDIAN_HOST=localhost
OBSIDIAN_PORT=27125
OBSIDIAN_USE_SSL=false

# API key from Obsidian MCP Bridge plugin settings
OBSIDIAN_MCP_KEY=your-api-key-here

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info
