# Obsidian MCP Bridge - Environment Variables Template
#
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# MCP Server Configuration
OBSIDIAN_HOST=localhost
OBSIDIAN_PORT=27125
OBSIDIAN_USE_SSL=false

# API Key (get from plugin settings)
# In Obsidian: Settings → MCP Bridge → Copy API Key
OBSIDIAN_MCP_KEY=your-api-key-here
